{
  "name": "sentrix-backend",
  "version": "1.0.0",
  "description": "RBAC & Security Monitoring System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:setup": "ts-node scripts/setup-database.ts",
    "db:drop": "ts-node scripts/drop-database.ts",
    "db:reset": "npm run db:drop && npm run db:setup",
    "db:seed": "ts-node scripts/seed-dummy-data.ts",
    "db:init": "npm run db:setup && npm run db:seed"
  },
  "keywords": [
    "rbac",
    "security",
    "authentication",
    "monitoring"
  ],
  "author": "Sentrix Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "geoip-lite": "^1.4.7",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "ua-parser-js": "^1.0.37",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/ua-parser-js": "^0.7.39",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
